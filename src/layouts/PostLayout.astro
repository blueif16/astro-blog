---
import PortfolioLayout from './PortfolioLayout.astro';
import ReadingTime from '../components/ReadingTime.astro';
import TagList from '../components/TagList.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  content: string;
  section?: string;
}

const { title, description, date, tags = [], content, section } = Astro.props;
---

<PortfolioLayout title={title} description={description}>

<style is:global>
  /* ── Post page: muted violet accent ── */
  body {
    --accent: #6d5aac;
    --accent-dim: rgba(109, 90, 172, 0.12);
    --card-border-hover: rgba(109, 90, 172, 0.28);
    --card-shadow-hover: 0 12px 48px rgba(0,0,0,0.10), 0 0 0 1px rgba(109,90,172,0.12);
  }

  /* ── Reading progress bar ── */
  .rp-bar {
    position: fixed;
    top: 0; left: 0;
    height: 2px;
    width: 0%;
    background: var(--accent);
    z-index: 10000;
    transition: width 0.08s linear;
    pointer-events: none;
  }

  /* ── Page layout ── */
  .post-page {
    min-height: 100vh;
    padding: 130px 40px 120px;
    max-width: 680px;
    margin: 0 auto;
  }

  /* ── Back link ── */
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
    background: none !important;
    background-image: none !important;
    margin-bottom: 52px;
    opacity: 0;
    transition: color 0.25s ease, gap 0.25s ease;
    cursor: inherit;
  }

  .post-back:hover {
    color: var(--accent);
    gap: 10px;
    background: none !important;
    background-image: none !important;
  }

  .post-back svg {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .post-back:hover svg { transform: translateX(-3px); }

  /* ── Post header ── */
  .post-header { margin-bottom: 52px; }

  .post-section-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
    opacity: 0;
  }

  .post-header h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.9rem, 4.5vw, 3.1rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 22px;
    opacity: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.74rem;
    color: var(--text-dim);
    margin-bottom: 16px;
    opacity: 0;
  }

  .post-meta time { font-weight: 500; }
  .post-meta .dot { opacity: 0.35; }

  /* TagList */
  .tag-scroll {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
    opacity: 0;
  }

  .tag-pill {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--accent-dim);
    color: var(--accent);
  }

  .post-divider {
    width: 40px;
    height: 2px;
    background: var(--accent);
    border: none;
    border-radius: 1px;
    margin: 28px 0 0;
    opacity: 0;
  }

  /* ── Post body ── */
  .post-body { opacity: 0; }

  .post-body p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.22rem;
    font-weight: 300;
    line-height: 1.78;
    color: var(--text);
    margin-bottom: 1.5em;
  }

  .post-body h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 2.8em 0 0.7em;
    color: var(--text);
  }

  .post-body h3 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.2rem;
    font-weight: 400;
    margin: 2.2em 0 0.6em;
    color: var(--text);
  }

  .post-body a {
    color: var(--accent);
    text-decoration-color: var(--accent-dim);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .post-body a:hover { text-decoration-color: var(--accent); }

  .post-body pre {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.84rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 1.1em 1.4em;
    overflow-x: auto;
    margin: 1.8em 0;
    line-height: 1.6;
  }

  .post-body code:not(pre code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.84em;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 5px;
    padding: 0.15em 0.45em;
  }

  .post-body blockquote {
    border-left: 2px solid var(--accent);
    padding: 0.2em 0 0.2em 1.5em;
    margin: 2em 0;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.18rem;
    font-weight: 300;
    color: var(--text-dim);
    line-height: 1.65;
  }

  .post-body ul,
  .post-body ol {
    padding-left: 1.4em;
    margin-bottom: 1.5em;
  }

  .post-body li {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.18rem;
    font-weight: 300;
    line-height: 1.68;
    margin-bottom: 0.35em;
    color: var(--text);
  }

  .post-body img {
    max-width: 100%;
    border-radius: 10px;
    margin: 1.5em 0;
  }

  .post-body hr {
    border: none;
    border-top: 1px solid var(--card-border);
    margin: 3em 0;
  }
</style>

<!-- Reading progress bar -->
<div class="rp-bar" id="rp-bar"></div>

<div class="post-page">
  {section && (
    <a href={`/${section}`} class="post-back" id="post-back">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      {section}
    </a>
  )}

  <article>
    <header class="post-header">
      {section && <div class="post-section-label" id="post-sl">{section}</div>}
      <h1 id="post-h1">{title}</h1>
      <div class="post-meta" id="post-meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span class="dot">&middot;</span>
        <ReadingTime content={content} />
      </div>
      {tags.length > 0 && <TagList tags={tags} />}
      <hr class="post-divider" id="post-div" />
    </header>

    <div class="post-body" id="post-body">
      <slot />
    </div>
  </article>
</div>

<script>
  // Reading progress
  const bar = document.getElementById('rp-bar') as HTMLElement | null;
  if (bar) {
    window.addEventListener('scroll', () => {
      const dh = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = dh > 0 ? `${(window.scrollY / dh) * 100}%` : '0%';
    }, { passive: true });
  }

  // Entrance sequence
  const seq: { id: string; delay: number }[] = [
    { id: 'post-back', delay: 0.05 },
    { id: 'post-sl',   delay: 0.12 },
    { id: 'post-h1',   delay: 0.22 },
    { id: 'post-meta', delay: 0.36 },
    { id: 'post-div',  delay: 0.50 },
    { id: 'post-body', delay: 0.62 },
  ];

  seq.forEach(({ id, delay }) => {
    const el = document.getElementById(id) as HTMLElement | null;
    if (!el) return;
    el.style.transition = `opacity 0.7s ease ${delay}s, transform 0.7s ease ${delay}s`;
    el.style.transform = 'translateY(14px)';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }));
  });

  // Tags (no ID, select by class)
  const tags = document.querySelector<HTMLElement>('.tag-scroll');
  if (tags) {
    tags.style.transition = 'opacity 0.7s ease 0.44s, transform 0.7s ease 0.44s';
    tags.style.transform = 'translateY(10px)';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      tags.style.opacity = '1';
      tags.style.transform = 'translateY(0)';
    }));
  }
</script>

</PortfolioLayout>
