---
interface Props {
  wordmark?: string;
  currentPath?: string;
}

const { wordmark = 'shiran', currentPath = Astro.url.pathname } = Astro.props;

const pages = [
  { href: '/', label: 'Portfolio' },
  { href: '/blog', label: 'Blog' },
  { href: '/feed', label: 'Feed' },
];
---

<nav class="fn" id="float-nav">
  <div class="fn-mark-zone" id="fn-mark-zone">
    <a href="/" class="fn-mark" data-cursor-hover>{wordmark}</a>
  </div>
  <span class="fn-sep"></span>
  <div class="fn-links">
    {pages.map(p => (
      <a
        href={p.href}
        class:list={['fn-link', { 'fn-active': p.href === '/' ? currentPath === '/' : currentPath.startsWith(p.href) }]}
        data-cursor-hover
      >
        {p.label}
      </a>
    ))}
  </div>
</nav>

<!-- Shiran drawer — slides down from nav on hover -->
<div class="shiran-backdrop" id="shiran-backdrop">
  <canvas class="shiran-particles-canvas" id="shiran-particles"></canvas>
</div>
<div class="shiran-drawer" id="shiran-drawer">
  <div class="shiran-drawer-inner">
    <p class="shiran-tagline">If you have great ideas,<br/>Let's talk!</p>
    <div class="shiran-links">
      <a href="https://github.com/blueif16" class="shiran-social" data-cursor-hover target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>GitHub</span>
      </a>
      <a href="https://www.linkedin.com/in/shiran-wang-2b2478338" class="shiran-social" data-cursor-hover target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</div>

<style is:global>
  .fn {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9990;
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 6px 0 20px;
    height: 42px;
    border-radius: 21px;
    background: transparent;
    border: 1px solid transparent;
    backdrop-filter: blur(0px) saturate(100%);
    -webkit-backdrop-filter: blur(0px) saturate(100%);
    transition:
      background 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      backdrop-filter 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      -webkit-backdrop-filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
  }

  .fn.fn-scrolled {
    background: var(--card-bg, rgba(245, 244, 240, 0.72));
    border-color: var(--card-border, rgba(58, 58, 56, 0.08));
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
  }

  .fn-mark {
    font-family: 'DM Serif Display', 'Instrument Serif', serif;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text, #3a3a38) !important;
    text-decoration: none !important;
    background: none !important;
    background-image: none !important;
    letter-spacing: -0.01em;
    transition: opacity 0.3s ease;
    cursor: inherit;
  }

  .fn-mark:hover {
    opacity: 0.7;
    background: none !important;
    background-image: none !important;
    color: var(--text, #3a3a38) !important;
  }

  .fn-sep {
    width: 1px;
    height: 16px;
    background: var(--card-border, rgba(58, 58, 56, 0.15));
    margin: 0 16px;
    flex-shrink: 0;
  }

  .fn-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .fn-link {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim, var(--text-muted, rgba(58, 58, 56, 0.5))) !important;
    text-decoration: none !important;
    background: none !important;
    background-image: none !important;
    padding: 6px 12px;
    border-radius: 12px;
    transition: color 0.3s ease, background-color 0.3s ease;
    position: relative;
    cursor: inherit;
  }

  .fn-link:hover {
    color: var(--text, #3a3a38) !important;
    background-color: rgba(0, 0, 0, 0.04) !important;
    background-image: none !important;
  }

  .fn-link.fn-active {
    color: var(--text, #3a3a38) !important;
  }

  .fn-link.fn-active::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent, #059669);
  }

  /* ── Mark zone wrapper ── */
  .fn-mark-zone {
    position: relative;
    display: flex;
    align-items: center;
    padding: 2px 4px;
    border-radius: 8px;
    transition: background 0.4s ease, box-shadow 0.4s ease;
  }

  .fn-mark-zone.shiran-active {
    background: rgba(5, 150, 105, 0.08);
    box-shadow: 0 0 12px rgba(5, 150, 105, 0.15);
  }

  .fn-mark-zone.shiran-active .fn-mark {
    opacity: 1 !important;
    color: var(--accent, #059669) !important;
  }

  /* ── Backdrop overlay ── */
  .shiran-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9988;
    background: rgba(26, 26, 24, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .shiran-backdrop.shiran-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Drawer panel ── */
  .shiran-drawer {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9989;
    width: 340px;
    pointer-events: none;
    opacity: 0;
  }

  .shiran-drawer-inner {
    margin-top: 50px;
    padding: 28px 28px 24px;
    border-radius: 0 0 20px 20px;
    background: rgba(38, 38, 36, 0.88);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-top: none;
    box-shadow:
      0 24px 64px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(5, 150, 105, 0.08) inset;
    transform: translateY(-20px);
    opacity: 0;
    transition:
      transform 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .shiran-drawer.shiran-open {
    opacity: 1;
    pointer-events: auto;
  }

  .shiran-drawer.shiran-open .shiran-drawer-inner {
    transform: translateY(0);
    opacity: 1;
  }

  .shiran-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.6;
    color: rgba(232, 230, 226, 0.85);
    text-align: center;
    margin-bottom: 20px;
  }

  .shiran-links {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  .shiran-social {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(232, 230, 226, 0.7) !important;
    text-decoration: none !important;
    background-image: none !important;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    cursor: inherit;
  }

  .shiran-social:hover {
    background: rgba(5, 150, 105, 0.12) !important;
    background-image: none !important;
    border-color: rgba(5, 150, 105, 0.25);
    color: rgba(232, 230, 226, 0.95) !important;
  }

  .shiran-social svg {
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .shiran-social:hover svg {
    opacity: 1;
  }

  .shiran-particles-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .fn {
      padding: 0 4px 0 16px;
      height: 38px;
      border-radius: 19px;
    }
    .fn-sep { margin: 0 10px; }
    .fn-link {
      font-size: 0.65rem;
      padding: 5px 8px;
    }
    .fn-mark { font-size: 0.95rem; }

    .shiran-drawer {
      width: calc(100vw - 32px);
    }
  }
</style>

<script>
  (function() {
    const nav = document.getElementById('float-nav');
    if (!nav) return;
    let ticking = false;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          nav.classList.toggle('fn-scrolled', window.scrollY > 80);
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ── Shiran drawer hover interaction ──
    const markZone = document.getElementById('fn-mark-zone');
    const drawer = document.getElementById('shiran-drawer');
    const backdrop = document.getElementById('shiran-backdrop');
    if (!markZone || !drawer || !backdrop) return;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    const CLOSE_DELAY = 280;
    let isOpen = false;

    function openDrawer() {
      clearTimeout(closeTimer!);
      markZone!.classList.add('shiran-active');
      drawer!.classList.add('shiran-open');
      backdrop!.classList.add('shiran-open');
      isOpen = true;
      startAnimation();
    }

    function scheduleClose() {
      clearTimeout(closeTimer!);
      closeTimer = setTimeout(() => {
        markZone!.classList.remove('shiran-active');
        drawer!.classList.remove('shiran-open');
        backdrop!.classList.remove('shiran-open');
        isOpen = false;
      }, CLOSE_DELAY);
    }

    markZone.addEventListener('mouseenter', openDrawer);
    markZone.addEventListener('mouseleave', scheduleClose);
    drawer.addEventListener('mouseenter', () => {
      clearTimeout(closeTimer!);
      startAnimation();
    });
    drawer.addEventListener('mouseleave', scheduleClose);

    backdrop.addEventListener('click', () => {
      clearTimeout(closeTimer!);
      markZone!.classList.remove('shiran-active');
      drawer!.classList.remove('shiran-open');
      backdrop!.classList.remove('shiran-open');
      isOpen = false;
    });

    // ══════════════════════════════════════════════════════════════
    // Atmospheric light motes — sparse, drifting, with faint threads
    // ══════════════════════════════════════════════════════════════

    const canvas = document.getElementById('shiran-particles') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(window.devicePixelRatio, 2);

    function resizeCanvas() {
      const cw = window.innerWidth;
      const ch = window.innerHeight;
      canvas.width = cw * dpr;
      canvas.height = ch * dpr;
      canvas.style.width = cw + 'px';
      canvas.style.height = ch + 'px';
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    const MOTE_COUNT = 28;
    const THREAD_DIST = 160; // max px distance for connecting threads

    interface Mote {
      x: number; y: number;
      vx: number; vy: number;
      r: number;           // core radius
      glow: number;        // glow radius multiplier
      baseAlpha: number;
      phase: number;       // unique phase offset for breathing
      speed: number;       // breathing speed
      hue: number;
      sat: number;
      light: number;
    }

    const motes: Mote[] = [];
    const w0 = window.innerWidth;
    const h0 = window.innerHeight;

    for (let i = 0; i < MOTE_COUNT; i++) {
      const isBright = Math.random() < 0.2;
      motes.push({
        x: Math.random() * w0,
        y: Math.random() * h0,
        vx: (Math.random() - 0.5) * 0.18,
        vy: (Math.random() - 0.5) * 0.14 - 0.06,
        r: isBright ? 2.2 + Math.random() * 1.5 : 1.0 + Math.random() * 1.2,
        glow: isBright ? 5 + Math.random() * 4 : 3 + Math.random() * 2,
        baseAlpha: isBright ? 0.5 + Math.random() * 0.3 : 0.15 + Math.random() * 0.2,
        phase: Math.random() * Math.PI * 2,
        speed: 0.3 + Math.random() * 0.4,
        hue: 150 + Math.random() * 40,       // emerald → teal
        sat: 30 + Math.random() * 35,
        light: isBright ? 75 + Math.random() * 15 : 60 + Math.random() * 15,
      });
    }

    let fadeAlpha = 0;
    let animId: number | null = null;
    let time = 0;

    function animate() {
      animId = requestAnimationFrame(animate);
      time += 0.016;

      const w = window.innerWidth;
      const h = window.innerHeight;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      // Fade
      if (isOpen) {
        fadeAlpha = Math.min(1, fadeAlpha + 0.03);
      } else {
        fadeAlpha = Math.max(0, fadeAlpha - 0.05);
      }

      if (fadeAlpha <= 0) {
        cancelAnimationFrame(animId!);
        animId = null;
        return;
      }

      // Update positions
      for (const m of motes) {
        m.x += m.vx + Math.sin(time * 0.3 + m.phase) * 0.08;
        m.y += m.vy + Math.cos(time * 0.25 + m.phase) * 0.05;

        // Soft wrap
        if (m.x < -40) m.x = w + 40;
        if (m.x > w + 40) m.x = -40;
        if (m.y < -40) { m.y = h + 40; m.x = Math.random() * w; }
        if (m.y > h + 40) { m.y = -40; m.x = Math.random() * w; }
      }

      // ── Draw threads between nearby motes ──
      for (let i = 0; i < motes.length; i++) {
        for (let j = i + 1; j < motes.length; j++) {
          const dx = motes[i].x - motes[j].x;
          const dy = motes[i].y - motes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < THREAD_DIST) {
            const strength = 1 - dist / THREAD_DIST;
            const a = strength * strength * 0.12 * fadeAlpha;
            ctx.beginPath();
            ctx.moveTo(motes[i].x, motes[i].y);
            ctx.lineTo(motes[j].x, motes[j].y);
            ctx.strokeStyle = `hsla(162, 35%, 70%, ${a})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      // ── Draw motes ──
      for (const m of motes) {
        const breath = 0.6 + 0.4 * Math.sin(time * m.speed + m.phase);
        const a = m.baseAlpha * fadeAlpha * breath;

        // Outer glow
        const grad = ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.r * m.glow);
        grad.addColorStop(0, `hsla(${m.hue}, ${m.sat}%, ${m.light}%, ${a * 0.6})`);
        grad.addColorStop(0.3, `hsla(${m.hue}, ${m.sat}%, ${m.light}%, ${a * 0.2})`);
        grad.addColorStop(1, `hsla(${m.hue}, ${m.sat}%, ${m.light}%, 0)`);
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r * m.glow, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();

        // Bright core
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r * 0.6, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${m.hue}, ${Math.min(m.sat + 15, 80)}%, ${Math.min(m.light + 10, 95)}%, ${a * 0.9})`;
        ctx.fill();
      }
    }

    function startAnimation() {
      if (!animId) animate();
    }
  })();
</script>
