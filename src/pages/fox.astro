---
import BaseLayout from '../layouts/BaseLayout.astro';
import StyledComponentsWrapper from '../components/StyledComponentsWrapper.jsx';

// Import MetaMask components
import SiteHeader from '../components/metamask/navigation/SiteHeader.jsx';
import SiteFooter from '../components/metamask/navigation/SiteFooter.jsx';
import AnimatedFeatureSection from '../components/metamask/animation/AnimatedFeatureSection.jsx';
import AnimatedCarousel from '../components/metamask/animation/AnimatedCarousel.jsx';
import FullWidthBanner from '../components/metamask/interactive/FullWidthBanner.jsx';
import CallToAction from '../components/metamask/interactive/CallToAction.jsx';

// Test header menus (like MetaMask)
const headerMenus = [
  { title: "Products", href: "#products" },
  { title: "Build", href: "#build" },
  { title: "Resources", href: "#resources" },
];

// Test footer menus
const footerMenus = [
  {
    title: "Learn",
    items: [
      { title: "About", href: "#" },
      { title: "Blog", href: "#" },
    ],
  },
  {
    title: "Connect",
    items: [
      { title: "Twitter", href: "#" },
      { title: "GitHub", href: "#" },
    ],
  },
];

// Test carousel items
const testCarouselItems = [
  {
    title: "Feature One",
    description: "<p>This is the first feature with some description text.</p>",
    image: "/assets/icons/icon-terminal.svg",
  },
  {
    title: "Feature Two",
    description: "<p>This is the second feature with some description text.</p>",
    image: "/assets/icons/icon-code.svg",
  },
  {
    title: "Feature Three",
    description: "<p>This is the third feature with some description text.</p>",
    image: "/assets/icons/icon-neural.svg",
  },
];
---

<BaseLayout title="MetaMask Component Test">
  <StyledComponentsWrapper client:only="react">
    <!-- Header -->
    <SiteHeader
      client:only="react"
      logo={{ logo: "/logo.svg" }}
      menus={headerMenus}
      isSticky={true}
      showDarkModeToggle={true}
    />

    <!-- Hero Section -->
    <AnimatedFeatureSection
      client:only="react"
      headline="<h1>MetaMask Component Test</h1>"
      description="<p style='font-size: 20px;'>Testing all components work exactly like the original MetaMask website.</p>"
      contentAlignment="center"
      animation={true}
      sectionPadding="120px 0 80px 0"
    />

    <!-- Feature Section 1 - Left Aligned -->
    <AnimatedFeatureSection
      client:only="react"
      headline="<h2>Buy & Swap Tokens</h2>"
      description="<p>First time? We make it easy. Buy crypto with a card or bank account.</p>"
      contentAlignment="left"
      animation={true}
      backgroundColor="default"
      sectionPadding="80px 0"
    />

    <!-- Feature Section 2 - Right Aligned -->
    <AnimatedFeatureSection
      client:only="react"
      headline="<h2>All Your Networks</h2>"
      description="<p>Access multiple blockchain networks from one wallet.</p>"
      contentAlignment="right"
      animation={true}
      backgroundColor="gray"
      sectionPadding="80px 0"
    />

    <!-- Carousel Section -->
    <AnimatedCarousel
      client:only="react"
      headline="<h2>Explore Features</h2>"
      description="<p>Discover what you can do with MetaMask.</p>"
      featureSliderItems={testCarouselItems}
      slideShow={true}
      animation={true}
      sectionPadding="80px 0"
    />

    <!-- Call to Action -->
    <CallToAction
      client:only="react"
      headline="Get Started Today"
      description="Download MetaMask and start exploring the decentralized web."
      ctas={[
        { text: "Download Now", href: "#download" }
      ]}
      layout="center"
      backgroundColor="default"
      sectionPadding="60px 0"
    />

    <!-- Full Width Banner -->
    <FullWidthBanner
      client:only="react"
      headline="Trusted by Millions"
      description="Join the community of users exploring Web3."
      ctas={[
        { text: "Learn More", href: "#learn", variant: "primary" }
      ]}
      sectionPadding="100px 0"
    />

    <!-- Footer -->
    <SiteFooter
      client:only="react"
      menus={footerMenus}
      copyright="© 2026 MetaMask Component Test"
    />
  </StyledComponentsWrapper>

  <!-- Smooth Scroll -->
  <script>
    import { initSmoothScroll } from '../components/metamask/layout/smooth-scroll.js';

    if (typeof window !== 'undefined') {
      const cleanup = initSmoothScroll();
      window.addEventListener('beforeunload', cleanup);
    }
  </script>
</BaseLayout>
