</div>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prepareWithSegments, layoutNextLine } from '@chenglou/pretext';

  gsap.registerPlugin(ScrollTrigger);

  // Cursor tracking + hover handled by PortfolioLayout
  const cards = document.querySelectorAll('.project-card');

  // ── Three.js ──
  const cntr = document.getElementById('hedgehog-canvas');
  const ren = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  ren.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  ren.setSize(280, 280);
  ren.toneMapping = THREE.ACESFilmicToneMapping;
  ren.toneMappingExposure = 1.2;
  ren.setClearColor(0x000000, 0);
  cntr.appendChild(ren.domElement);

  const sc = new THREE.Scene();
  const pmrem = new THREE.PMREMGenerator(ren);
  const env = new RoomEnvironment();
  sc.environment = pmrem.fromScene(env, 0.04).texture;
  env.dispose();

  const dl = new THREE.DirectionalLight(0xffffff, 1.5);
  dl.position.set(5, 10, 7); sc.add(dl);
  const fl = new THREE.DirectionalLight(0xb0c4de, 0.8);
  fl.position.set(-5, 3, -5); sc.add(fl);
  sc.add(new THREE.HemisphereLight(0xffffff, 0x8d8d8d, 1.0));

  const cam = new THREE.PerspectiveCamera(35, 1, 0.1, 1000);
  cam.position.set(0, 30, 120);
  const oc = new OrbitControls(cam, ren.domElement);
  oc.enableDamping = true; oc.dampingFactor = 0.08;
  oc.enablePan = false; oc.enableZoom = false; oc.enableRotate = false;
  oc.target.set(0, 0, 0); oc.update();

  const mouse = { x: 0, y: 0 };
  const mouseClient = { x: 0, y: 0 };
  const tRot = { x: 0, y: 0 };
  let hm = null, hoveredCard = null;

  document.addEventListener('mousemove', e => {
    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
    mouseClient.x = e.clientX;
    mouseClient.y = e.clientY;
  });

  // ── Center intro text — Pretext canvas layout ──
  const centerIntro = document.getElementById('center-intro-text');
  let introCanvas = null;
  let introActive = false;
  let introPrepared = null;

  const INTRO_FONT = '300 17px Cormorant Garamond, serif';
  const INTRO_LINE_H = 30;
  const INTRO_COLOR = '#5a5a55';

  function ensureIntroCanvas() {
    if (introCanvas) return;
    introCanvas = document.createElement('canvas');
    centerIntro.appendChild(introCanvas);
  }

  function renderIntroText() {
    if (!introActive || !introPrepared) return;

    const rect = centerIntro.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio, 2);
    const w = rect.width, h = rect.height;
    if (w < 1 || h < 1) { requestAnimationFrame(renderIntroText); return; }

    const cw = Math.round(w * dpr), ch = Math.round(h * dpr);
    if (introCanvas.width !== cw || introCanvas.height !== ch) {
      introCanvas.width = cw;
      introCanvas.height = ch;
      introCanvas.style.width = w + 'px';
      introCanvas.style.height = h + 'px';
    }
    const ctx = introCanvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.font = INTRO_FONT;
    ctx.fillStyle = INTRO_COLOR;
    ctx.textBaseline = 'top';

    // Hedgehog obstacle (relative to container)
    const hedgeRect = document.getElementById('hedgehog-mover').getBoundingClientRect();
    const hCX = hedgeRect.left + hedgeRect.width / 2 - rect.left;
    const hCY = hedgeRect.top + hedgeRect.height / 2 - rect.top;
    const hR = 150;
    const pad = 14;

    // Start text at top edge of circle
    let cursor = { segmentIndex: 0, graphemeIndex: 0 };
    let y = Math.max(10, hCY - hR);
    let done = false;

    while (y < h - INTRO_LINE_H && !done) {
      const mid = y + INTRO_LINE_H / 2;
      const hdy = mid - hCY;

      if (Math.abs(hdy) < hR) {
        // Line crosses the hedgehog — render text on BOTH sides
        const chordHalf = Math.sqrt(hR * hR - hdy * hdy);
        const circleLeft = hCX - chordHalf - pad;
        const circleRight = hCX + chordHalf + pad;
        const leftW = circleLeft;
        const rightW = w - circleRight;

        // Left portion
        if (leftW > 30 && !done) {
          const line = layoutNextLine(introPrepared, cursor, leftW);
          if (!line) { done = true; break; }
          ctx.fillText(line.text, 0, y);
          cursor = line.end;
        }

        // Right portion (continues the same text stream)
        if (rightW > 30 && !done) {
          const line = layoutNextLine(introPrepared, cursor, rightW);
          if (!line) { done = true; break; }
          ctx.fillText(line.text, circleRight, y);
          cursor = line.end;
        }
      } else {
        // Line is above or below circle — full width
        const line = layoutNextLine(introPrepared, cursor, w);
        if (!line) break;
        ctx.fillText(line.text, 0, y);
        cursor = line.end;
      }

      y += INTRO_LINE_H;
    }

    if (introActive) requestAnimationFrame(renderIntroText);
  }

  function startIntro(text) {
    ensureIntroCanvas();
    // Kill any pending fade-out
    gsap.killTweensOf(centerIntro);
    introPrepared = prepareWithSegments(text, INTRO_FONT);
    introActive = true;
    gsap.to(centerIntro, { opacity: 1, duration: 0.4, overwrite: true });
    renderIntroText();
  }

  function stopIntro() {
    introActive = false;
    gsap.to(centerIntro, {
      opacity: 0, duration: 0.3, overwrite: true,
      onComplete: () => {
        introPrepared = null;
        if (introCanvas) {
          const ctx = introCanvas.getContext('2d');
          if (ctx) ctx.clearRect(0, 0, introCanvas.width, introCanvas.height);
        }
      }
    });
  }

  cards.forEach(c => {
    c.addEventListener('mouseenter', () => {
      hoveredCard = c;
      const intro = c.dataset.intro;
      if (intro) startIntro(intro);
    });
    c.addEventListener('mouseleave', () => {
      hoveredCard = null;
      stopIntro();
    });
  });

  let hScale = 1;
  new GLTFLoader().load('/Hedgehog.glb', gltf => {
    hm = gltf.scene;
    const box = new THREE.Box3().setFromObject(hm);
    const cen = box.getCenter(new THREE.Vector3());
    const sz = box.getSize(new THREE.Vector3());
    hScale = 60 / Math.max(sz.x, sz.y, sz.z);
    hm.scale.setScalar(hScale);
    hm.position.sub(cen.multiplyScalar(hScale));
    hm.scale.setScalar(0.001);
    sc.add(hm);
    gsap.to(hm.scale, {
      x: hScale, y: hScale, z: hScale,
      duration: 1.2, ease: 'elastic.out(1, 0.5)', delay: 0.3,
    });
  });

  (function anim() {
    requestAnimationFrame(anim);
    if (hm) {
      if (hoveredCard) {
        // Look directly at the hovered card
        const cardRect = hoveredCard.getBoundingClientRect();
        const hedgeRect = cntr.getBoundingClientRect();
        const hedgeCX = hedgeRect.left + hedgeRect.width / 2;
        const hedgeCY = hedgeRect.top + hedgeRect.height / 2;
        const cardCX = cardRect.left + cardRect.width / 2;
        const cardCY = cardRect.top + cardRect.height / 2;
        const dx = cardCX - hedgeCX;
        const dy = cardCY - hedgeCY;
        // Normalize to roughly -1..1 range based on screen dimensions
        const nx = Math.max(-1, Math.min(1, dx / (window.innerWidth * 0.4)));
        const ny = Math.max(-1, Math.min(1, dy / (window.innerHeight * 0.4)));
        tRot.y = nx * 0.8;
        tRot.x = ny * 0.4;
      } else {
        // Idle: gentle follow mouse
        tRot.y = mouse.x * 0.25;
        tRot.x = -mouse.y * 0.3;
      }
      hm.rotation.y += (tRot.y - hm.rotation.y) * 0.08;
      hm.rotation.x += (tRot.x - hm.rotation.x) * 0.08;
    }
    oc.update();
    ren.render(sc, cam);
  })();

  // ══════════════════════════════════════════════════════════════════════════
  // CharSplitter — reusable per-character scroll animation framework
  // ══════════════════════════════════════════════════════════════════════════
  //
  // USAGE:
  //   1. Add `data-splitfly="unique-id"` to any text element in HTML.
  //   2. Call `splitElement(el)` to split its text into per-char spans.
  //      Returns { el, chars, words } for animation.
  //   3. Use `buildFlyInTimeline(chars, trajectories)` /
  //      `buildFlyOutTimeline(chars, trajectories)` to build GSAP timelines,
  //      or use `splitFlyScroll(el, opts)` for full scroll-driven
  //      fly-in → hold → fly-out sequences.
  //
  // Each char gets a seeded random trajectory so animations look organic
  // but are deterministic across reloads. Trajectory direction is based on
  // char's position relative to the element center — left chars fly left, etc.
  //
  // PRESETS (pass to computeTrajectories):
  //   'radial'  — chars explode outward from center (default)
  //   'rise'    — chars float upward with slight horizontal drift
  //   'fall'    — chars tumble downward
  //   'scatter' — pure random in all directions
  //
  // EXAMPLE (minimal):
  //   <h2 data-splitfly="my-title">Hello World</h2>
  //   const el = document.querySelector('[data-splitfly="my-title"]');
  //   splitFlyScroll(el, {
  //     trigger: '#my-section',
  //     start: 'top 80%',
  //     end: 'bottom 20%',
  //     preset: 'radial',
  //   });
  //
  // EXAMPLE (manual control):
  //   const { chars } = splitElement(el);
  //   const trajs = computeTrajectories(chars, 'rise', 1.5);
  //   const tl = buildFlyInTimeline(chars, trajs);
  //   ScrollTrigger.create({ trigger: el, scrub: 1, animation: tl });
  //
  // ──────────────────────────────────────────────────────────────────────────

  /** Deterministic pseudo-random from a seed (mulberry32). */
  function seededRandom(seed) {
    let t = seed + 0x6D2B79F5;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }

  /**
   * Split a DOM element's text into per-character <span>s.
   * Groups characters into word wrappers for natural line-breaking.
   * @param {HTMLElement} el — element with data-splitfly
   * @returns {{ el, chars: HTMLElement[], words: HTMLElement[] }}
   */
  // Detect CJK characters (Chinese/Japanese/Korean)
  const CJK_RE = /[\u3000-\u9FFF\uF900-\uFAFF\u{20000}-\u{2FA1F}]/u;

  function splitElement(el) {
    const text = el.textContent;
    el.innerHTML = '';
    el.style.opacity = '1';

    const chars = [];
    const words = [];
    const segments = text.split(/(\s+)/);

    segments.forEach(seg => {
      if (/^\s+$/.test(seg)) {
        const sp = document.createElement('span');
        sp.className = 'sf-space';
        el.appendChild(sp);
      } else {
        const wordEl = document.createElement('span');
        wordEl.className = 'sf-word';
        for (const ch of seg) {
          const span = document.createElement('span');
          span.className = CJK_RE.test(ch) ? 'sf-char sf-char-cjk' : 'sf-char';
          span.textContent = ch;
          wordEl.appendChild(span);
          chars.push(span);
        }
        el.appendChild(wordEl);
        words.push(wordEl);
      }
    });

    return { el, chars, words };
  }

  /**
   * Compute per-char fly targets based on preset.
   * @param {HTMLElement[]} chars
   * @param {'radial'|'rise'|'fall'|'scatter'} preset
   * @param {number} intensity — distance multiplier (default 1)
   * @returns {Array<{x,y,z,rotation,scale}>}
   */
  function computeTrajectories(chars, preset = 'radial', intensity = 1) {
    const count = chars.length;
    const mid = (count - 1) / 2;

    return chars.map((_, i) => {
      const seed = i * 2654435761;
      const r1 = seededRandom(seed);
      const r2 = seededRandom(seed + 1);
      const r3 = seededRandom(seed + 2);
      const norm = (i - mid) / Math.max(mid, 1); // -1 to 1

      switch (preset) {
        case 'radial': {
          const angle = norm * Math.PI * 0.6 + (r1 - 0.5) * 0.8;
          const dist = (80 + r2 * 120) * intensity;
          return {
            x: Math.cos(angle) * dist * (norm < 0 ? -1 : 1),
            y: (r3 - 0.5) * 80 * intensity - 30 * intensity,
            z: (r1 - 0.3) * 150 * intensity,
            rotation: norm * 45 * intensity + (r2 - 0.5) * 30,
            scale: 0.3 + r3 * 0.4,
          };
        }
        case 'rise':
          return {
            x: norm * 40 * intensity + (r1 - 0.5) * 30,
            y: -(60 + r2 * 80) * intensity,
            z: (r1 - 0.5) * 60 * intensity,
            rotation: (r3 - 0.5) * 20 * intensity,
            scale: 0.5 + r1 * 0.3,
          };
        case 'fall':
          return {
            x: norm * 50 * intensity + (r1 - 0.5) * 40,
            y: (60 + r2 * 100) * intensity,
            z: (r3 - 0.5) * 80 * intensity,
            rotation: norm * 35 * intensity,
            scale: 0.4 + r2 * 0.3,
          };
        case 'scatter':
        default:
          return {
            x: (r1 - 0.5) * 300 * intensity,
            y: (r2 - 0.5) * 200 * intensity,
            z: (r3 - 0.5) * 200 * intensity,
            rotation: (r1 - 0.5) * 90 * intensity,
            scale: 0.2 + r2 * 0.5,
          };
      }
    });
  }

  /**
   * GSAP timeline: chars fly FROM scattered TO assembled (readable).
   * @param {HTMLElement[]} chars
   * @param {Object[]} trajectories — from computeTrajectories()
   * @param {{ stagger?: number, ease?: string }} opts
   */
  function buildFlyInTimeline(chars, trajectories, opts = {}) {
    const { stagger = 0.02, ease = 'power3.out' } = opts;
    const tl = gsap.timeline();
    chars.forEach((ch, i) => {
      const t = trajectories[i];
      tl.fromTo(ch,
        { x: t.x, y: t.y, z: t.z, rotation: t.rotation, scale: t.scale, opacity: 0 },
        { x: 0, y: 0, z: 0, rotation: 0, scale: 1, opacity: 1, ease, duration: 1 },
        i * stagger
      );
    });
    return tl;
  }

  /**
   * GSAP timeline: chars fly FROM assembled TO scattered.
   * @param {HTMLElement[]} chars
   * @param {Object[]} trajectories — from computeTrajectories()
   * @param {{ stagger?: number, ease?: string }} opts
   */
  function buildFlyOutTimeline(chars, trajectories, opts = {}) {
    const { stagger = 0.02, ease = 'power3.in' } = opts;
    const tl = gsap.timeline();
    chars.forEach((ch, i) => {
      const t = trajectories[i];
      tl.fromTo(ch,
        { x: 0, y: 0, z: 0, rotation: 0, scale: 1, opacity: 1 },
        { x: t.x, y: t.y, z: t.z, rotation: t.rotation, scale: t.scale, opacity: 0, ease, duration: 1 },
        i * stagger
      );
    });
    return tl;
  }

  /**
   * Full scroll-driven split-fly: fly-in → hold → fly-out.
   *
   * @param {HTMLElement} el — element with data-splitfly
   * @param {object} opts
   * @param {string}  opts.trigger   — ScrollTrigger trigger (default: el itself)
   * @param {string}  opts.start     — ST start (default 'top 80%')
   * @param {string}  opts.end       — ST end (default 'bottom 20%')
   * @param {string}  opts.preset    — trajectory preset (default 'radial')
   * @param {number}  opts.intensity — fly distance multiplier (default 1)
   * @param {string}  opts.inPreset  — override preset for fly-in only
   * @param {string}  opts.outPreset — override preset for fly-out only
   * @param {number}  opts.holdRatio — fraction of scroll spent holding (0-1, default 0.3)
   * @returns {{ chars, words, masterTl }}
   */
  function splitFlyScroll(el, opts = {}) {
    const {
      trigger,
      start = 'top 80%',
      end = 'bottom 20%',
      preset = 'radial',
      intensity = 1,
      inPreset,
      outPreset,
      holdRatio = 0.3,
    } = opts;

    const { chars, words } = splitElement(el);
    const inTrajs = computeTrajectories(chars, inPreset || preset, intensity);
    const outTrajs = computeTrajectories(chars, outPreset || preset, intensity);

    // Master timeline: [fly-in] [hold gap] [fly-out]
    const masterTl = gsap.timeline({
      scrollTrigger: {
        trigger: trigger || el,
        start,
        end,
        scrub: 1.5,
      }
    });

    masterTl.add(buildFlyInTimeline(chars, inTrajs), 0);
    masterTl.add(buildFlyOutTimeline(chars, outTrajs), `>${holdRatio}`);

    return { chars, words, masterTl };
  }

  /**
   * Avoidance-based text split: chars repel away from a fixed element
   * (e.g. the hedgehog) as they scroll past it, arcing around it like
   * water flowing around a rock.
   *
   * How it works:
   *   - Pre-measures each char's resting x/y offset within the element.
   *   - On every scroll frame, computes each char's viewport position
   *     vs. the avoidance element's center.
   *   - Chars within `radius` get pushed outward along the radial
   *     direction, with an optional tangential arc component.
   *   - Uses gsap.set() for 60fps performance (no tweens, instant).
   *
   * USAGE:
   *   splitAvoid(el, {
   *     avoidEl: document.getElementById('hedgehog-mover'),
   *     radius: 200,      // influence zone in px
   *     strength: 140,     // max displacement in px
   *     arc: true,         // add tangential flow (chars curve around)
   *     fadeEdge: 0.3,     // opacity at max proximity (0 = invisible)
   *   });
   *
   * @param {HTMLElement} el — text element to split
   * @param {object} opts
   * @param {HTMLElement} opts.avoidEl   — element to avoid (center used)
   * @param {number}  opts.radius        — influence radius in px (default 200)
   * @param {number}  opts.strength      — max push distance in px (default 140)
   * @param {boolean} opts.arc           — tangential arc flow (default true)
   * @param {number}  opts.fadeEdge      — min opacity at closest point (default 0.3)
   * @param {string}  opts.trigger       — ScrollTrigger trigger (default: el)
   * @returns {{ chars, update, kill }}
   */
  function splitAvoid(el, opts = {}) {
    const {
      avoidEl,
      radius = 200,
      strength = 140,
      arc = true,
      fadeEdge = 0.3,
      trigger,
    } = opts;

    const { chars, words } = splitElement(el);

    // Pre-measure each char's resting position relative to element's top-left.
    // Must wait one frame for layout after splitElement rewrites innerHTML.
    let charOffsets = null;

    function measureChars() {
      const elRect = el.getBoundingClientRect();
      charOffsets = chars.map(ch => {
        const r = ch.getBoundingClientRect();
        return {
          // Center of char relative to element's top-left
          relX: (r.left + r.width / 2) - elRect.left,
          relY: (r.top + r.height / 2) - elRect.top,
        };
      });
    }

    function update() {
      if (!charOffsets) {
        measureChars();
      }

      const avoidRect = avoidEl.getBoundingClientRect();
      const aCX = avoidRect.left + avoidRect.width / 2;
      const aCY = avoidRect.top + avoidRect.height / 2;
      const elRect = el.getBoundingClientRect();

      chars.forEach((ch, i) => {
        const off = charOffsets[i];
        // Char's current viewport center (before any transform)
        const charVX = elRect.left + off.relX;
        const charVY = elRect.top + off.relY;

        const dx = charVX - aCX;
        const dy = charVY - aCY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < radius && dist > 0.1) {
          const factor = 1 - (dist / radius);    // 1 at center → 0 at edge
          const eased = factor * factor;          // quadratic ease — smooth falloff
          const angle = Math.atan2(dy, dx);

          let pushX, pushY;
          if (arc) {
            // Radial push + tangential sweep = chars arc around the obstacle
            const tangent = angle + Math.PI / 2 * (dx >= 0 ? 1 : -1);
            pushX = Math.cos(angle) * strength * eased
                  + Math.cos(tangent) * strength * 0.35 * eased;
            pushY = Math.sin(angle) * strength * eased
                  + Math.sin(tangent) * strength * 0.35 * eased;
          } else {
            // Pure radial push — chars split straight outward
            pushX = Math.cos(angle) * strength * eased;
            pushY = Math.sin(angle) * strength * eased;
          }

          gsap.set(ch, {
            x: pushX,
            y: pushY,
            rotation: eased * (dx >= 0 ? 18 : -18),
            opacity: 1 - eased * (1 - fadeEdge),
            scale: 1 - eased * 0.15,
          });
        } else {
          // Outside influence — snap back to resting position
          gsap.set(ch, { x: 0, y: 0, rotation: 0, opacity: 1, scale: 1 });
        }
      });
    }

    const st = ScrollTrigger.create({
      trigger: trigger || el,
      start: 'top bottom',
      end: 'bottom top',
      onUpdate: update,
    });

    // Also run update on resize (char positions change)
    const onResize = () => { charOffsets = null; };
    window.addEventListener('resize', onResize);

    return {
      chars,
      words,
      update,
      kill: () => { st.kill(); window.removeEventListener('resize', onResize); },
    };
  }

  // ══════════════════════════════════════════════
  // Page animations
  // ══════════════════════════════════════════════

  const hedgeMover = document.getElementById('hedgehog-mover');

  // ── Hero title: chars assemble on load, fly out on scroll ──
  const heroTitleEl = document.querySelector('[data-splitfly="hero-title"]');
  const heroTitleSplit = splitElement(heroTitleEl);
  const heroTitleTrajs = computeTrajectories(heroTitleSplit.chars, 'scatter', 1.2);

  // Load entrance: scatter → assemble
  heroTitleSplit.chars.forEach((ch, i) => {
    const t = heroTitleTrajs[i];
    gsap.fromTo(ch,
      { x: t.x * 0.5, y: t.y * 0.5, rotation: t.rotation * 0.5, opacity: 0, scale: 0.6 },
      { x: 0, y: 0, rotation: 0, opacity: 1, scale: 1,
        duration: 1.2, ease: 'power3.out', delay: 0.15 + i * 0.025 }
    );
  });

  // Fly out when leaving hero
  const heroOutTl = buildFlyOutTimeline(heroTitleSplit.chars, heroTitleTrajs, { stagger: 0.015, ease: 'power2.in' });
  ScrollTrigger.create({
    trigger: '#intro',
    start: 'bottom 70%',
    end: 'bottom 20%',
    scrub: 1,
    animation: heroOutTl,
  });

  // ── Hero quote: load in, chars rise away on scroll ──
  const heroQuoteEl = document.querySelector('[data-splitfly="hero-quote"]');
  const heroQuoteSplit = splitElement(heroQuoteEl);
  const heroQuoteTrajs = computeTrajectories(heroQuoteSplit.chars, 'rise', 0.6);

  gsap.fromTo('.hero-quote', { opacity: 0 }, { opacity: 1, duration: 1.2, ease: 'power3.out', delay: 0.9 });

  const quoteOutTl = buildFlyOutTimeline(heroQuoteSplit.chars, heroQuoteTrajs, { stagger: 0.008, ease: 'power2.in' });
  ScrollTrigger.create({
    trigger: '#intro',
    start: 'bottom 85%',
    end: 'bottom 25%',
    scrub: 1,
    animation: quoteOutTl,
  });

  gsap.to('.hero-sub', { opacity: 1, y: 0, duration: 1, ease: 'power3.out', delay: 0.5 });

  // ── Hedgehog movement: hero bottom → screen center ──
  ScrollTrigger.create({
    trigger: '#stack',
    start: 'top bottom',
    end: 'top top',
    scrub: 1,
    onUpdate: (self) => {
      const p = self.progress;
      const startBottom = window.innerHeight * 0.06;
      const endY = window.innerHeight * 0.5 - 185;
      const startY = window.innerHeight - startBottom - 280;
      const currentY = startY + (endY - startY) * p;
      hedgeMover.style.position = 'fixed';
      hedgeMover.style.bottom = 'auto';
      hedgeMover.style.top = currentY + 'px';
      hedgeMover.style.left = '50%';
      hedgeMover.style.transform = 'translateX(-50%)';
    }
  });

  // Keep hedgehog visible through projects section.
  // The projects section is pinned (+3000px scroll), so we tie to the
  // pin's own ScrollTrigger end by using the same trigger + end value.
  ScrollTrigger.create({
    trigger: '#projects',
    start: 'top top',
    end: '+=3000',
    onLeave: () => {
      gsap.to(hedgeMover, { opacity: 0, duration: 0.5 });
    },
    onEnterBack: () => {
      gsap.to(hedgeMover, { opacity: 1, duration: 0.3 });
    },
  });

  // ── Intro: hedgehog scales up as section enters (stays big) ──
  gsap.to('#hedgehog-canvas', {
    scale: 1.29,
    transformOrigin: 'center center',
    ease: 'none',
    scrollTrigger: {
      trigger: '#stack',
      start: 'top 70%',
      end: 'top top',
      scrub: 1,
    }
  });

  // ── Stack text: fade in when section is visible ──
  gsap.to('#intro-text-1', {
    opacity: 1,
    duration: 0.8,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#stack',
      start: 'top 40%',
      toggleActions: 'play none none reverse',
    }
  });

  // ── Skill cards: start off-screen in 4 directions ──
  gsap.set('#skill-tl', { x: -420, opacity: 0 });
  gsap.set('#skill-tr', { y: -420, opacity: 0 });
  gsap.set('#skill-bl', { y: 420, opacity: 0 });
  gsap.set('#skill-br', { x: 420, opacity: 0 });

  // Cards fly in as section enters
  const cardsInTl = gsap.timeline({
    scrollTrigger: {
      trigger: '#stack',
      start: 'top 55%',
      end: 'top top',
      scrub: 1,
    }
  });
  cardsInTl
    .to('#skill-tl', { x: 0, opacity: 1, ease: 'power2.out' }, 0)
    .to('#skill-tr', { y: 0, opacity: 1, ease: 'power2.out' }, 0.05)
    .to('#skill-bl', { y: 0, opacity: 1, ease: 'power2.out' }, 0.1)
    .to('#skill-br', { x: 0, opacity: 1, ease: 'power2.out' }, 0.15);

  // Cards fly out in reverse as section exits toward projects
  const cardsOutTl = gsap.timeline({
    scrollTrigger: {
      trigger: '#stack',
      start: 'bottom 75%',
      end: 'bottom 25%',
      scrub: 1,
    }
  });
  cardsOutTl
    .to('#skill-tl', { x: -420, opacity: 0, ease: 'power2.in' }, 0)
    .to('#skill-tr', { y: -420, opacity: 0, ease: 'power2.in' }, 0.05)
    .to('#skill-bl', { y: 420, opacity: 0, ease: 'power2.in' }, 0.1)
    .to('#skill-br', { x: 420, opacity: 0, ease: 'power2.in' }, 0.15);

  // ── Cards ──
  cards.forEach(c => c.classList.remove('card-hidden'));

  // Measure columns + viewport
  const colLeft = document.getElementById('col-left');
  const colRight = document.getElementById('col-right');
  const vh = window.innerHeight;
  const leftH = colLeft.offsetHeight;
  const rightH = colRight.offsetHeight;

  // Initial positions: left fully above viewport, right fully below
  gsap.set(colLeft, { y: -leftH });
  gsap.set(colRight, { y: vh });

  const projectsTl = gsap.timeline({
    scrollTrigger: {
      trigger: '#projects',
      start: 'top top',
      end: '+=3000',
      scrub: 1,
      pin: true,
    }
  });

  // Left: enters from TOP, slides DOWN through and out bottom
  projectsTl.to(colLeft, { y: vh, ease: 'none' }, 0);

  // Right: enters from BOTTOM, slides UP through and out top
  projectsTl.to(colRight, { y: -rightH, ease: 'none' }, 0);

  // Per-card fade-in
  cards.forEach(card => {
    gsap.fromTo(card,
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 0.6, ease: 'power2.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 90%',
          toggleActions: 'play none none reverse',
        },
      }
    );
  });

  // ── Readme: staggered line reveals (fly-in only, text stays) ──
  const readmeTrigger = '#readme';

  // Filename slides in
  gsap.fromTo('.readme-filename',
    { opacity: 0, x: -20 },
    { opacity: 1, x: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: readmeTrigger, start: 'top 70%', toggleActions: 'play none none reverse' },
    }
  );

  // Line 1 — main statement, chars rise in (fly-in only)
  const l1El = document.querySelector('[data-splitfly="readme-l1"]');
  const l1Split = splitElement(l1El);
  const l1Trajs = computeTrajectories(l1Split.chars, 'rise', 0.5);
  const l1Tl = buildFlyInTimeline(l1Split.chars, l1Trajs, { stagger: 0.025, ease: 'power3.out' });
  ScrollTrigger.create({
    trigger: readmeTrigger,
    start: 'top 60%',
    end: 'top 30%',
    scrub: 1.5,
    animation: l1Tl,
  });

  // Line 2 — detail, gentle rise
  const l2El = document.querySelector('[data-splitfly="readme-l2"]');
  const l2Split = splitElement(l2El);
  const l2Trajs = computeTrajectories(l2Split.chars, 'rise', 0.4);
  const l2Tl = buildFlyInTimeline(l2Split.chars, l2Trajs, { stagger: 0.015, ease: 'power3.out' });
  ScrollTrigger.create({
    trigger: readmeTrigger,
    start: 'top 50%',
    end: 'top 20%',
    scrub: 1.5,
    animation: l2Tl,
  });

  // Cursor blink appears after line 2
  gsap.to('.readme-cursor', {
    opacity: 1, duration: 0.3,
    scrollTrigger: { trigger: readmeTrigger, start: 'top 25%', toggleActions: 'play none none reverse' },
  });

  // EOF footer
  gsap.fromTo('.readme-footer',
    { opacity: 0 },
    { opacity: 0.35, duration: 0.6, ease: 'power3.out',
      scrollTrigger: { trigger: readmeTrigger, start: 'top 10%', toggleActions: 'play none none reverse' },
    }
  );
</script>

</PortfolioLayout>
