---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const sections = [
  { id: 'intro', label: 'Intro' },
  { id: 'stack', label: 'Stack' },
  { id: 'projects', label: 'Projects' },
  { id: 'readme', label: 'readme.md' },
];

const projects = [
  {
    id: 'sre-agent', side: 'left', tag: 'Autonomous Ops',
    title: 'SRE Agent',
    desc: 'Autonomous incident response: Datadog alert → LLM investigation → auto-fix → GitHub PR.',
    expandDesc: 'Confidence × severity matrix decides autonomy level. Claude Code in CodeBuild for isolated fixes.',
    intro: 'Built for the Datadog + AWS hackathon. A Strands agent detects production incidents via Datadog, investigates root causes with MCP tools, applies a confidence × severity matrix to decide what to do, and — when confidence is high enough — generates a tested code fix as a GitHub PR via Claude Code running in CodeBuild. The whole pipeline from alert to merged fix runs without human intervention when it can, and pages you when it can\'t.',
    tech: ['Python', 'Strands', 'Datadog MCP', 'AWS CodeBuild'],
    link: 'https://github.com/blueif16/sre-agent',
  },
  {
    id: 'copilot-scaffold', side: 'left', tag: 'Full-Stack AI',
    title: 'Copilot Scaffold',
    desc: 'Production-ready scaffold for full-stack AI agents with CopilotKit + LangGraph.',
    expandDesc: 'Bidirectional state sync, AG-UI protocol, type-safe frontend-to-agent bridge.',
    intro: 'The scaffold I reach for whenever I need a full-stack AI agent fast. CopilotKit on the frontend handles bidirectional state sync with a LangGraph backend over the AG-UI protocol — so the agent\'s state and the React UI stay perfectly in lockstep. Pinned versions, tested patterns, and a startup script that gets both servers running in seconds. It\'s the foundation I\'ve used for multiple projects since.',
    tech: ['Next.js', 'React', 'LangGraph', 'FastAPI'],
    link: 'https://github.com/blueif16/copilot-scaffold',
  },
  {
    id: 'cc-sts', side: 'left', tag: 'Game AI',
    title: 'CC-STS',
    desc: 'AI agent that plays Slay the Spire 2 autonomously via pure LLM reasoning.',
    expandDesc: 'No hardcoded strategy — every decision is LLM reasoning over a searchable knowledge base.',
    intro: 'No decision trees, no priority tables. The agent reads game knowledge the same way a human reads a wiki, then reasons about what to do. A planner agent loads enemy files, archetype docs, and the current deck state, reasons through each option, and calls math scripts for lethal searches and draw probability when it needs precision. After every fight, a reflector agent reviews what worked and updates memory. Targeting Ascension 10.',
    tech: ['Claude Code', 'MCP', 'Python', 'Knowledge Base'],
    link: 'https://github.com/blueif16/cc-sts',
  },
  {
    id: 'cloudmate', side: 'left', tag: 'Agent Orchestration',
    title: 'CloudMate',
    desc: 'From one sentence to a coordinated agent team. No dashboards. No servers. Just planning.',
    expandDesc: 'Classifies intent, generates task DAG, executes solo or spawns Agent Teams in tmux.',
    intro: 'A skill and command for Claude Code. You say what you want — it classifies intent, assesses complexity, generates a task DAG with acceptance criteria, and executes at the right level. Simple tasks run solo. Medium ones spawn subagents within your session. Complex ones fire up an Agent Team: teammates appear as tmux split panes, each in its own git worktree, self-claiming unblocked tasks and merging back automatically. When the team finishes, the row collapses back to a single pane. The whole point is that orchestration should feel like talking, not configuring.',
    tech: ['Claude Code', 'Agent Teams', 'tmux', 'Git Worktrees'],
    link: 'https://github.com/blueif16/amazing-claude-code-plugins/tree/main/cloudmate',
  },
  {
    id: 'product-video', side: 'left', tag: 'Video Generation',
    title: 'Product Video',
    desc: 'You describe your app. It creates the video. AI-powered product video pipeline.',
    expandDesc: '14 text animations, 6 backgrounds, 10 image transforms. Remotion rendering.',
    intro: 'Describe your app and get a Product Hunt launch video. The pipeline analyzes your codebase, captures screens, creates a layered video spec, and renders with Remotion. It ships with a full animation catalog — 14 text animations from typewriter to glitch, 6 background types including animated orbs and film grain, 10 image transforms like ken burns and parallax, and 3 spring physics feels. You get a final MP4 ready for Product Hunt, no video editing skills required.',
    tech: ['Remotion', 'React', 'FFmpeg', 'Claude Code'],
    link: 'https://github.com/blueif16/product-video',
  },
  {
    id: 'domain-memory', side: 'left', tag: 'Knowledge Graph',
    title: 'Domain Memory',
    desc: 'Temporal knowledge graph for personal journals with autonomous optimization.',
    expandDesc: 'Decay-weighted relationships, smart briefings, self-tuning eval loop.',
    intro: 'A temporal knowledge graph that extracts entities, tracks relationships, and generates intelligent daily briefings from personal journal entries. Relationships decay over time so briefings stay relevant. The system self-improves through an autonomous optimization loop — it synthesizes test scenarios, judges its own briefing quality, and tunes its extraction knobs via git-committed experiments. Each morning you get a summary of what actually matters today, weighted by recency and graph connections.',
    tech: ['LangGraph', 'Supabase', 'Neo4j', 'Gemini'],
    link: 'https://github.com/blueif16/domain-memory',
  },
  {
    id: 'notebook-storyboard', side: 'right', tag: 'Creative AI',
    title: 'Copilot Storyboard',
    desc: 'AI-powered storybook generator with real-time streaming and human-in-the-loop.',
    expandDesc: 'Hierarchical LangGraph subgraphs with context isolation and AG-UI interrupt protocol.',
    intro: 'Describe a story idea and watch it come to life. Copilot Storyboard uses hierarchical LangGraph subgraphs — each stage (story enhancement, character portraits, page layout) operates with private message context so nothing bleeds between phases. At every stage the agent pauses for your review through AG-UI interrupts, so you shape the story as it forms. The architecture keeps context clean: the parent graph only holds final outputs while each subgraph handles its own feedback loops internally.',
    tech: ['CopilotKit', 'LangGraph', 'AG-UI', 'React'],
    link: 'https://github.com/blueif16/notebook-storyboard',
  },
  {
    id: 'supa-rag', side: 'right', tag: 'RAG Infrastructure',
    title: 'Supa RAG Scaffold',
    desc: 'The source of truth for LLM-assisted RAG setup. Rich content, minimal metadata.',
    expandDesc: 'RRF (BM25 + Vector) + Graph search. Gemini embeddings. Supabase backend.',
    intro: 'When I or an LLM needs to add RAG to a project, this is the scaffold we reference. The philosophy is simple: content should be rich and self-describing so embeddings capture everything, metadata stays minimal — just source and type for reference. The power comes from indexing: RRF combines BM25 keyword search with vector similarity and graph traversal. Gemini embeddings at 768 dimensions hit the sweet spot between performance and quality. One import, one function call, and you\'re ingesting.',
    tech: ['Supabase', 'Gemini', 'LangGraph', 'PostgreSQL'],
    link: 'https://github.com/blueif16/supa-langgraph-rag-scaffold',
  },
  {
    id: 'yiban', side: 'right', tag: 'Mobile App',
    title: '衣半 (Yiban)',
    desc: 'Weather-based outfit recommendation app with soft minimalist editorial design.',
    expandDesc: 'SwiftUI native. Real-time weather → personalized clothing suggestions.',
    intro: 'A SwiftUI app that turns weather data into outfit recommendations with a soft minimalist editorial aesthetic. Check the weather and get personalized clothing suggestions — styled cards, glass morphism menus, and a paged scroll layout that makes getting dressed feel considered. Built with Observable view models, localization support, and an auto-generation system for outfit combinations based on your wardrobe and conditions.',
    tech: ['SwiftUI', 'WeatherKit', 'Observable', 'CoreLocation'],
    link: 'https://github.com/blueif16/yiban',
  },
  {
    id: 'cc-telegram', side: 'right', tag: 'Remote Control',
    title: 'CC × Telegram',
    desc: 'Remote monitoring and control of Claude Code sessions through Telegram.',
    expandDesc: 'Real-time notifications, remote commands, interactive Q&A via Telegram buttons.',
    intro: 'Run Claude Code tasks on your server and control everything from your phone. The system pushes real-time notifications to Telegram when tasks complete, tools fire, or subagents run. You can send commands back to the Claude Code tmux session directly from chat, and when the agent needs input via AskUserQuestion, you answer through Telegram buttons instead of sitting at a terminal. Multi-project support with independent sessions — a main server plus per-project servers, each on its own port.',
    tech: ['Python', 'Telegram Bot API', 'tmux', 'Claude Code'],
    link: 'https://github.com/blueif16/claude-code-with-telegram',
  },
  {
    id: '2x', side: 'right', tag: 'Writing Partner',
    title: '2X',
    desc: 'Turn your daily work into social media posts. X, LinkedIn, Reddit.',
    expandDesc: 'Collects GitHub commits, browser history, chat sessions. You shape the draft, it publishes.',
    intro: 'Two chances a day to put out something that genuinely represents your thinking. Not AI-generated slop — real words that reflect what\'s in your head. 2X monitors your GitHub activity, browser history, and chat sessions, then starts a conversation about what felt most interesting. You go back and forth until the draft feels right, it generates platform-specific versions, and publishes via your browser. The whole point is that if you have any independently formed thought at all, saying it out loud is always better than not.',
    tech: ['OpenClaw', 'Chrome MCP', 'LLM', 'CLI'],
    link: 'https://github.com/blueif16/2X',
  },
];
---

<PortfolioLayout title="About" sections={sections}>

<style is:global>
  /* ── Hero ── */
  .hero {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-top {
    padding-top: 12vh;
    text-align: center;
  }

  .hero-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    opacity: 0;
  }

  .hero-sub {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    opacity: 0;
  }

  .hero-quote {
    position: absolute;
    bottom: calc(6vh + 300px);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    opacity: 0;
    max-width: 480px;
    z-index: 3;
  }

  .hero-quote blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.6;
    color: var(--text);
  }

  .hero-quote cite {
    display: block;
    margin-top: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    font-style: normal;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* ── Hedgehog wrapper — starts at hero bottom, moves to center via GSAP ── */
  .hedgehog-wrapper {
    position: absolute;
    bottom: 6vh;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }

  #hedgehog-canvas {
    width: 280px; height: 280px;
    border-radius: 50%;
  }

  #hedgehog-canvas canvas {
    display: block;
    width: 100% !important; height: 100% !important;
    border-radius: 50%;
  }

  /* ── Intro section — 3-col grid, skill cards fly in from 4 directions ── */
  .intro-section {
    position: relative;
    height: 250vh;
    z-index: 3;
    background: #ebe7df;
  }

  .intro-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 300px 1fr 300px;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    height: 100%;
    padding: 40px 0;
    box-sizing: border-box;
    gap: 24px;
  }

  .intro-col-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    pointer-events: auto;
  }

  .intro-col-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  /* Hedgehog anchor — GSAP positions the real hedgehog here */
  .intro-hedge-slot {
    width: 280px;
    height: 280px;
    flex-shrink: 0;
  }

  .intro-text {
    text-align: center;
    max-width: 300px;
    opacity: 0;
  }

  .intro-text p {
    font-size: 0.78rem;
    line-height: 1.5;
    color: #5a5a55;
    font-style: italic;
  }

  /* Hover label — vertical, top-right corner of hedgehog */
  .hedge-hover-label {
    position: absolute;
    top: 12px;
    right: -8px;
    display: flex;
    flex-direction: row;
    gap: 6px;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .hedgehog-wrapper:hover .hedge-hover-label {
    opacity: 1;
  }

  .hedge-hover-label .intro-name {
    font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: #1a1a18;
  }

  .hedge-hover-label p {
    font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
    font-size: 0.72rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    color: #5a5a55;
    margin: 0;
  }

  .intro-text .intro-name {
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #1a1a18;
    display: block;
    margin-bottom: 6px;
  }

  .intro-text p {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #5a5a55;
  }

  /* ── Skill cards ── */
  .skill-card {
    flex: 1;
    border-radius: 20px;
    padding: 28px;
    min-height: 0;
    overflow: hidden;
  }

  #skill-tl { background: #2c2853; }
  #skill-bl { background: #1d2e28; }
  #skill-tr { background: #3d1f28; }
  #skill-br { background: #c4614a; }

  .sk-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 4px;
  }

  .sk-subtitle {
    font-family: 'DM Serif Display', serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 10px;
  }

  .sk-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.74rem;
    font-weight: 400;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 14px;
  }

  .sk-tags {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sk-tags span {
    font-family: 'DM Serif Display', serif;
    font-size: 1.05rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.2;
  }

  /* ── CharSplitter: per-character animation support ──
     Style block is already is:global so no :global() wrappers needed. */
  [data-splitfly] {
    perspective: 800px;
  }
  .sf-char {
    display: inline-block;
    will-change: transform, opacity;
  }
  .sf-word {
    display: inline-block;
    white-space: nowrap;
  }
  .sf-space {
    display: inline-block;
    width: 0.3em;
  }
  .sf-char-cjk {
    margin-right: 0.05em;
  }

  /* ── Projects ── */
  .projects-section {
    position: relative;
    z-index: 5;
    overflow: hidden;
    background: #e5e6e2;
  }

  .projects-layout {
    display: grid;
    grid-template-columns: 300px 1fr 300px;
    height: 100vh;
    align-items: start;
    padding: 0 120px;
  }

  .card-column {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .card-column.left {
    padding: 40px 20px 80px 20px;
    will-change: transform;
  }

  .card-column.right {
    padding: 40px 20px 80px 20px;
    will-change: transform;
  }

  /* Center column — hedgehog sticks here + decorative content */
  .center-col {
    position: relative;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
    pointer-events: none;
  }

  .center-intro-text {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 240px);
    height: 100%;
    pointer-events: none;
    opacity: 0;
    z-index: 1;
  }

  .center-intro-text canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .center-deco-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, transparent, var(--accent), transparent);
    opacity: 0.3;
    margin-top: 16px;
  }

  .center-deco-label {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-top: 12px;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  #center-hedge-slot {
    width: 280px;
    height: 280px;
  }

  /* ── Project card ── */
  .project-card {
    position: relative;
    padding: 22px 22px 18px;
    border-radius: 16px;
    background: var(--card-bg);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid var(--card-border);
    box-shadow: var(--card-shadow);
    transition: transform 0.4s cubic-bezier(0.4,0,0.2,1),
                opacity 0.4s ease,
                background 0.4s ease,
                border-color 0.4s ease,
                box-shadow 0.4s ease;
    overflow: hidden;
    will-change: transform, opacity;
  }

  .project-card.card-hidden {
    opacity: 0;
    transform: translateY(24px);
  }

  .project-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-4px) scale(1.02);
  }

  .card-expand {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.5s cubic-bezier(0.4,0,0.2,1),
                opacity 0.4s ease 0.1s,
                margin-top 0.4s ease;
    margin-top: 0;
  }

  .project-card:hover .card-expand {
    max-height: 200px;
    opacity: 1;
    margin-top: 12px;
  }

  .card-tag {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--accent-dim);
    color: var(--accent);
    margin-bottom: 10px;
  }

  .card-title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.25;
    margin-bottom: 5px;
  }

  .card-desc {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .card-expand-desc {
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 8px;
  }

  .card-tech span {
    font-size: 0.62rem;
    font-weight: 500;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(58,58,56,0.06);
    color: var(--text-dim);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.3s ease;
  }
  .card-link:hover { gap: 10px; }

  /* ── Readme ── */
  .readme {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 40px;
    position: relative;
    z-index: 5;
    background: #e4e6e2;
  }

  .readme-inner {
    max-width: 520px;
    width: 100%;
  }

  .readme-filename {
    font-family: 'IBM Plex Mono', 'SF Mono', 'Fira Code', monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 28px;
    opacity: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .readme-filename::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
    opacity: 0.5;
  }

  .readme-line {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 2;
    color: var(--text);
    opacity: 0;
  }

  .readme-line.dim {
    color: var(--text-dim);
    font-size: 1.05rem;
  }

  .readme-cursor {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    background: var(--accent);
    margin-left: 4px;
    vertical-align: text-bottom;
    animation: cursorBlink 1s steps(1) infinite;
    opacity: 0;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .readme-footer {
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    opacity: 0;
  }
</style>

<!-- The actual hedgehog — GSAP will reparent/move this -->
<div class="hedgehog-wrapper" id="hedgehog-mover">
  <div id="hedgehog-canvas"></div>
  <div class="hedge-hover-label" id="hedge-hover-label">
    <span class="intro-name">合意猬</span>
    <p>一只有品的刺猬</p>
  </div>
</div>

<div class="page-wrapper">

  <!-- Intro: title top, hedgehog at bottom, quote above hedge -->
  <section class="hero" id="intro">
    <div class="hero-top">
      <h1 class="hero-title" data-splitfly="hero-title">Building things that matter</h1>
      <p class="hero-sub">scroll to explore</p>
    </div>
    <div class="hero-quote">
      <blockquote data-splitfly="hero-quote">Have the courage to follow your heart and intuition.</blockquote>
      <cite>Steve Jobs</cite>
    </div>
  </section>

  <!-- Stack: hedgehog enlarged at center, tech stack cards fly in from 4 directions -->
  <section class="intro-section" id="stack">
    <div class="intro-sticky">
      <div class="intro-grid">
        <div class="intro-col-side">
          <div class="skill-card" id="skill-tl">
            <p class="sk-label">01 / AGENTS</p>
            <p class="sk-subtitle">orchestration layer</p>
            <p class="sk-tagline">Building things that think in loops</p>
            <div class="sk-tags">
              <span>Orchestration</span><span>Context management</span><span>AG-UI</span><span>Agentic workflow</span>
            </div>
          </div>
          <div class="skill-card" id="skill-bl">
            <p class="sk-label">02 / LLM</p>
            <p class="sk-subtitle">post-training</p>
            <p class="sk-tagline">Shaping the model after pretraining</p>
            <div class="sk-tags">
              <span>SFT</span><span>RFT</span><span>GRPO</span><span>Distillation</span>
            </div>
          </div>
        </div>
        <div class="intro-col-center">
          <div class="intro-hedge-slot"></div>
          <div class="intro-text" id="intro-text-1">
            <p>These are the tech stacks that I'm familiar with</p>
          </div>
        </div>
        <div class="intro-col-side">
          <div class="skill-card" id="skill-tr">
            <p class="sk-label">03 / FULL STACK</p>
            <p class="sk-subtitle">ship surface</p>
            <p class="sk-tagline">From idea to shippable in a weekend</p>
            <div class="sk-tags">
              <span>React</span><span>Next.js</span><span>shadcn/ui</span><span>Swift</span>
            </div>
          </div>
          <div class="skill-card" id="skill-br">
            <p class="sk-label">04 / PRODUCTION</p>
            <p class="sk-subtitle">ship & keep shipping</p>
            <p class="sk-tagline">Taking AI from demo to reliable</p>
            <div class="sk-tags">
              <span>Observability</span><span>LLM-as-judge evals</span><span>Model gateway</span><span>Guardrails</span>
