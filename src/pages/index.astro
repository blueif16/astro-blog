  <!-- readme.md -->
  <section class="readme" id="readme">
    <div class="readme-inner">
      <span class="readme-filename">readme.md</span>
      <p class="readme-line" data-splitfly="readme-l1">Building either dev tool or an actual product.</p>
      <p class="readme-line dim" data-splitfly="readme-l2">Currently working with K-12 education AI.<span class="readme-cursor"></span></p>
