---
import BaseLayout from '../layouts/BaseLayout.astro';
import StyledComponentsWrapper from '../components/StyledComponentsWrapper.jsx';

// Import MetaMask components
import SiteHeader from '../components/metamask/navigation/SiteHeader.jsx';
import SiteFooter from '../components/metamask/navigation/SiteFooter.jsx';
import AnimatedFeatureSection from '../components/metamask/animation/AnimatedFeatureSection.jsx';
import AnimatedCarousel from '../components/metamask/animation/AnimatedCarousel.jsx';
import FullWidthBanner from '../components/metamask/interactive/FullWidthBanner.jsx';

// Personal content
const CONTENT = {
  name: "Shiran",
  title: "Builder of AI-Powered Developer Tools",
  subtitle: "I orchestrate AI agents to ship software. CS @ Northeastern.",
  whatIDo: {
    title: "What I Do",
    description: "I design and build multi-agent orchestration systems, Claude Code plugins, and workflow automation. I think programming is transitioning from code-oriented to agent-and-context-oriented.",
  },
  projects: [
    {
      title: "CloudMate",
      description: "Tmux-based orchestration for parallel Claude Code sessions across git worktrees with automated PR pipelines.",
      tags: ["Claude Code", "tmux", "git worktrees"],
      image: "/placeholder-project.png",
    },
    {
      title: "GoDag",
      description: "Natural language → DAG-based multi-agent task execution with real-time visualization dashboard.",
      tags: ["DAG", "Multi-agent", "React Flow"],
      image: "/placeholder-project.png",
    },
    {
      title: "AccessVision",
      description: "AI-powered WCAG accessibility audit agent for the Gemini Live Agent Challenge.",
      tags: ["Accessibility", "Gemini", "Hackathon"],
      image: "/placeholder-project.png",
    },
    {
      title: "OpenClaw",
      description: "Workflow documentation and tooling for Chinese enterprise users — 飞书, 钉钉, 企业微信.",
      tags: ["China-first", "Enterprise", "Automation"],
      image: "/placeholder-project.png",
    },
  ],
  stack: {
    title: "How I Work",
    description: "I operate as an orchestrator — directing AI coding agents rather than writing every line. My infrastructure: Claude Code, git worktrees, MCP servers, Obsidian for knowledge management.",
  },
  cta: {
    title: "Let's Build Something",
    description: "I'm always exploring new tools and agent architectures.",
    github: "https://github.com/blueif16",
  },
};

// Header navigation
const headerMenus = [
  { title: "Blog", href: "/blog" },
  { title: "Projects", href: "/projects" },
  { title: "Notes", href: "/notes" },
  { title: "About", href: "/about" },
];

// Footer navigation
const footerMenus = [
  {
    title: "Content",
    items: [
      { title: "Blog", href: "/blog" },
      { title: "Projects", href: "/projects" },
      { title: "Notes", href: "/notes" },
      { title: "Guides", href: "/guides" },
    ],
  },
  {
    title: "Connect",
    items: [
      { title: "GitHub", href: "https://github.com/blueif16" },
      { title: "Twitter", href: "https://twitter.com/blueif16" },
    ],
  },
];

// Prepare carousel items for projects
const carouselItems = CONTENT.projects.map(project => ({
  title: project.title,
  description: `<p>${project.description}</p><p style="margin-top: 8px; font-size: 14px; color: #6A737D;">${project.tags.join(' • ')}</p>`,
  image: project.image,
}));
---

<BaseLayout title="Home">
  <StyledComponentsWrapper client:only="react">
    <!-- Site Header -->
    <SiteHeader
      client:only="react"
      logo={{ logo: "/logo.svg" }}
      menus={headerMenus}
      isSticky={true}
      showDarkModeToggle={false}
    />

    <!-- Hero Section -->
    <AnimatedFeatureSection
      client:only="react"
      headline={`<h1>${CONTENT.name}</h1>`}
      description={`<p style="font-size: 24px; line-height: 1.5; margin-bottom: 8px;">${CONTENT.title}</p><p style="font-size: 18px; color: #6A737D;">${CONTENT.subtitle}</p>`}
      contentAlignment="center"
      animation={true}
      sectionPadding="120px 0 80px 0"
      headlineMarginTop0={true}
    />

    <!-- What I Do Section -->
    <AnimatedFeatureSection
      client:only="react"
      headline={`<h2>${CONTENT.whatIDo.title}</h2>`}
      description={`<p style="font-size: 18px; line-height: 1.6;">${CONTENT.whatIDo.description}</p>`}
      contentAlignment="left"
      animation={true}
      backgroundColor="gray"
      sectionPadding="80px 0"
    />

    <!-- Projects Carousel -->
    <AnimatedCarousel
      client:only="react"
      headline="<h2>Projects</h2>"
      description="<p>Building tools for the AI-native development workflow.</p>"
      featureSliderItems={carouselItems}
      animation={true}
      sectionPadding="80px 0"
    />

    <!-- How I Work Section -->
    <AnimatedFeatureSection
      client:only="react"
      headline={`<h2>${CONTENT.stack.title}</h2>`}
      description={`<p style="font-size: 18px; line-height: 1.6;">${CONTENT.stack.description}</p>`}
      contentAlignment="right"
      animation={true}
      backgroundColor="gray"
      sectionPadding="80px 0"
    />

    <!-- CTA Banner -->
    <FullWidthBanner
      client:only="react"
      headline={CONTENT.cta.title}
      description={CONTENT.cta.description}
      ctas={[
        { text: "View on GitHub", href: CONTENT.cta.github, variant: "primary", newTab: true }
      ]}
      sectionPadding="80px 0"
    />

    <!-- Site Footer -->
    <SiteFooter
      client:only="react"
      menus={footerMenus}
      copyright="© 2026 Shiran. Built with Astro."
    />
  </StyledComponentsWrapper>

  <!-- Lenis Smooth Scroll -->
  <script>
    import { initSmoothScroll } from '../components/metamask/layout/smooth-scroll.js';

    // Initialize smooth scroll on page load
    if (typeof window !== 'undefined') {
      const cleanup = initSmoothScroll();

      // Cleanup on page unload
      window.addEventListener('beforeunload', cleanup);
    }
  </script>
</BaseLayout>
