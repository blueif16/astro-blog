  <!-- Projects: left cards, center hedge, right cards -->
  <section class="projects-section" id="projects">
    <div class="projects-layout">

      <div class="card-column left" id="col-left">
        {projects.filter(p => p.side === 'left').map(p => (
          <div class="project-card card-hidden" data-cursor-hover data-side="left" data-project-id={p.id} data-intro={p.intro}>
            <span class="card-tag">{p.tag}</span>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-desc">{p.desc}</p>
            <div class="card-expand">
              <p class="card-expand-desc">{p.expandDesc}</p>
              <div class="card-tech">{p.tech.map(t => <span>{t}</span>)}</div>
              <a href={p.link} class="card-link">View project <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1.5 7h11M8.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        ))}
      </div>

      <div class="center-col">
        <div id="center-hedge-slot"></div>
        <div id="center-intro-text" class="center-intro-text"></div>
        <div class="center-deco-line"></div>
        <span class="center-deco-label">projects</span>
      </div>

      <div class="card-column right" id="col-right">
        {projects.filter(p => p.side === 'right').map(p => (
          <div class="project-card card-hidden" data-cursor-hover data-side="right" data-project-id={p.id} data-intro={p.intro}>
            <span class="card-tag">{p.tag}</span>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-desc">{p.desc}</p>
            <div class="card-expand">
              <p class="card-expand-desc">{p.expandDesc}</p>
              <div class="card-tech">{p.tech.map(t => <span>{t}</span>)}</div>
              <a href={p.link} class="card-link">View project <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1.5 7h11M8.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        ))}
