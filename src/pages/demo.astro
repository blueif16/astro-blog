---
// demo.astro — drop into src/pages/
// Minimal page: just the card, centered, dark backdrop for contrast.
import CryptoCard from "../components/CryptoCard.jsx";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Card Animation Demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,700;0,9..40,800;1,9..40,400&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0c0612;
        font-family: 'DM Sans', system-ui, sans-serif;
        /* Subtle gradient to give the background some life */
        background-image:
          radial-gradient(ellipse at 30% 20%, rgba(100, 40, 180, 0.08) 0%, transparent 60%),
          radial-gradient(ellipse at 70% 80%, rgba(80, 30, 160, 0.06) 0%, transparent 60%);
      }
    </style>
  </head>
  <body>
    <!-- client:load hydrates immediately so hover works on first interaction -->
    <CryptoCard client:load />
  </body>
</html>
