---
// The feed: a briefing for each day, newest first, grouped by month. Each row is the day, its
// reading time, and the leads of its highlights (the bullets under "## 重点").
import JournalLayout from '../../layouts/JournalLayout.astro';
import { getLiveCollection } from 'astro:content';
import { fmtDay, fmtDayShort, fmtMonth, fmtWeekdayShort, highlights, isoDay, readingMinutes } from '../../utils/journal';

// Rendered from the vault on request; Vercel keeps it until the vault's workflow refreshes it.
export const prerender = false;

const { entries, error } = await getLiveCollection('feed');
if (error) throw error;

const days = entries
  .map((entry) => ({ entry, date: new Date(entry.data.date), slug: isoDay(new Date(entry.data.date)) }))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  // One page per day, as the day pages have it.
  .filter((d, i, all) => all.findIndex((o) => o.slug === d.slug) === i);

const byMonth = new Map<string, typeof days>();
for (const d of days) {
  const key = d.slug.slice(0, 7);
  byMonth.set(key, [...(byMonth.get(key) ?? []), d]);
}
const months = [...byMonth.keys()].sort().reverse();
const latest = days[0];
const first = days[days.length - 1];
---

<JournalLayout title="Feed, Shiran Wang" description="A briefing for each day." area="feed">
  <header class="j-head phi">
    <div class="cell a">
      <h1 class="j-title">Feed</h1>
    </div>
    <div class="cell b col">
      <p>A briefing for each day.</p>
      {latest && <a class="read-more" href={`/feed/${latest.slug}`}>Latest, {fmtDayShort(latest.date)} →</a>}
    </div>
    <div class="cell c col">
      <dl class="meta">
        <div><dt>Days</dt><dd>{days.length}</dd></div>
        {first && latest && <div><dt>From</dt><dd>{fmtDay(first.date)} to {fmtDay(latest.date)}</dd></div>}
        <div><dt>Also</dt><dd><a href="/blog">Blog</a></dd></div>
      </dl>
    </div>
  </header>

  {days.length === 0 && (
    <section class="phi j-group-head">
      <p class="cell a kicker">Nothing here yet.</p>
    </section>
  )}

  {months.map((m) => {
    const list = byMonth.get(m)!;
    return (
      <section class="j-group" id={`m${m}`} aria-labelledby={`m${m}-label`}>
        <div class="phi j-group-head">
          <h2 class="cell a j-group-label" id={`m${m}-label`}>{fmtMonth(list[0].date)}</h2>
          <p class="cell b kicker">{list.length} {list.length === 1 ? 'day' : 'days'}</p>
        </div>
        <ol class="j-list">
          {list.map((d) => {
            const points = highlights(d.entry.data.body, 3);
            return (
              <li>
                <a class="phi j-row" href={`/feed/${d.slug}`}>
                  <span class="cell a"><span class="j-row-title">{fmtWeekdayShort(d.date)} {fmtDayShort(d.date)}</span></span>
                  <span class="cell b j-row-meta">
                    <time datetime={d.slug}>{d.slug}</time>
                    <span>{readingMinutes(d.entry.data.body)} min read</span>
                  </span>
                  <span class="cell c">
                    {points.length > 0 && (
                      <ol class="j-row-points" lang="zh">
                        {points.map((p) => <li>{p}</li>)}
                      </ol>
                    )}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    );
  })}
</JournalLayout>
