---
// One day's briefing, set like a post: the day as the title, the facts and the days on either side
// at the top, the briefing to the right of the first cut with its sections held in view on the
// left, and the way to the day before and after at the end. (The archive drawer of the first
// version is the feed's index now, /feed.)
import JournalLayout from '../../layouts/JournalLayout.astro';
import Contents from '../../components/journal/Contents.astro';
import { getLiveCollection, getLiveEntry, render } from 'astro:content';
import { contentsOf, fmtDay, fmtWeekday, isoDay, readingMinutes } from '../../utils/journal';

// Rendered from the vault on request; Vercel keeps it until the vault's workflow refreshes it.
export const prerender = false;

const { date: slug } = Astro.params;

const { entries, error: listError } = await getLiveCollection('feed');
if (listError) throw listError;
const days = entries
  .map((entry) => ({ entry, slug: isoDay(new Date(entry.data.date)) }))
  .sort((a, b) => a.slug.localeCompare(b.slug))
  .filter((d, i, all) => all.findIndex((o) => o.slug === d.slug) === i);
const i = days.findIndex((d) => d.slug === slug);
if (i < 0) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const previous = i > 0 ? days[i - 1].slug : undefined;
const next = i < days.length - 1 ? days[i + 1].slug : undefined;

const { entry, error } = await getLiveEntry('feed', days[i].entry.id);
if (!entry) throw error;
const { Content, headings } = await render(entry);
const date = new Date(entry.data.date);
const contents = contentsOf(headings);
const dayOf = (s: string) => fmtDay(new Date(`${s}T00:00:00Z`));
const tags = entry.data.tags.filter((t) => t !== 'briefing');
---

<JournalLayout title={`Feed, ${dayOf(slug!)}, Shiran Wang`} description="Daily briefing" area="feed" reading>
  <article>
    <header class="j-head phi">
      <div class="cell a">
        <p class="kicker"><a href="/feed">← Feed</a></p>
        <h1 class="j-title">{fmtDay(date)}</h1>
      </div>
      <div class="cell b col">
        <p>Daily briefing, {fmtWeekday(date)}.</p>
        {contents.length > 1 && <a class="read-more" href={`#${contents[0].slug}`}>Start reading ↓</a>}
      </div>
      <div class="cell c col">
        <dl class="meta">
          <div><dt>Date</dt><dd><time datetime={slug}>{slug}</time></dd></div>
          <div><dt>Reading</dt><dd>{readingMinutes(entry.data.body)} min</dd></div>
          {tags.length > 0 && <div><dt>Tags</dt><dd>{tags.join(', ')}</dd></div>}
          <div><dt>Archive</dt><dd><a href="/feed">Every day</a></dd></div>
        </dl>
        <nav class="pager" aria-label="Days">
          {previous ? <a href={`/feed/${previous}`} rel="prev">← {dayOf(previous)}</a> : <span />}
          {next ? <a href={`/feed/${next}`} rel="next">{dayOf(next)} →</a> : <span />}
        </nav>
      </div>
    </header>

    <div class="j-body phi">
      <div class="cell a"><Contents items={contents} label="Sections" /></div>
      <div class="cell bc">
        <div class="prose" lang="zh">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <nav class="phi note-next j-next" aria-label="More days">
    {previous ? (
      <a class="cell a" href={`/feed/${previous}`} rel="prev">
        <span class="kicker">The day before</span>
        <span class="next-title">← {dayOf(previous)}</span>
      </a>
    ) : <span class="cell a" />}
    <span class="cell b"><a class="j-all" href="/feed">Every day</a></span>
    {next ? (
      <a class="cell c" href={`/feed/${next}`} rel="next">
        <span class="kicker">The day after</span>
        <span class="next-title">{dayOf(next)} →</span>
      </a>
    ) : <span class="cell c" />}
  </nav>
</JournalLayout>
